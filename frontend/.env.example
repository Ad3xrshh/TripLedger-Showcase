# Base URL of the TripLedger backend API.
# Defaults to http://localhost:4000/api if not set (see src/api/client.js).
VITE_API_BASE_URL=http://localhost:4000/api

# Google OAuth client ID used for "Continue with Google" (Google Identity
# Services - see src/components/auth/GoogleSignInButton.jsx). Must be the
# same client ID the backend verifies against (backend's GOOGLE_CLIENT_ID,
# see backend/src/utils/googleAuth.js) - they're two env vars for the same
# Google Cloud OAuth client, one per app. Leave unset to omit the Google
# sign-in button entirely; email/password auth is unaffected either way.
VITE_GOOGLE_CLIENT_ID=
