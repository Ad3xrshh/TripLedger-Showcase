# Copy this file to backend/.env and fill in real values. Do not commit a
# real .env - if the repo doesn't already ignore it, that's Pass 4's
# concern, not this one.

# ---------------------------------------------------------------------------
# Development database (used by `npm run dev` / `npm start`)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tripledger:tripledger@localhost:5432/tripledger

# ---------------------------------------------------------------------------
# Pass 3: dedicated TEST database - never point this at the same database
# as DATABASE_URL above. The test suite (`npm test`, which sets
# NODE_ENV=test - see package.json and src/config/db.js) connects here
# instead, so integration tests' INSERT/DELETE fixture and cleanup queries
# never touch development data.
#
# Create it once, then run migrations against it:
#   createdb tripledger_test
#   npm run test:migrate
# (test:migrate points node-pg-migrate's DATABASE_URL at this value - see
# package.json. If TEST_DATABASE_URL isn't already exported in your shell,
# export it first, e.g.: export TEST_DATABASE_URL=postgresql://tripledger:tripledger@localhost:5432/tripledger_test)
#
# src/config/db.js refuses to start under NODE_ENV=test if this is unset,
# rather than silently falling back to DATABASE_URL.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://tripledger:tripledger@localhost:5432/tripledger_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign/verify JWTs (src/utils/jwt.js). Use a long random
# value in any real environment - never reuse this example value.
JWT_SECRET=

# Google OAuth 2.0 Client ID from Google Cloud Console (backend verifies
# Google ID tokens against this - see src/utils/googleAuth.js). Must match
# the frontend's VITE_GOOGLE_CLIENT_ID (see frontend/.env.example) - same
# OAuth client, two apps.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Defaults to 4000 if not set (see src/index.js).
PORT=4000

# Comma-separated list of frontend origins allowed to call this API (see
# src/index.js). Unset in local dev - defaults to Vite's dev server
# origins (http://localhost:5173, http://127.0.0.1:5173). Set this to
# your real frontend URL(s) in any deployed environment, e.g.:
#   CORS_ORIGIN=https://tripledger.example.com
CORS_ORIGIN=
